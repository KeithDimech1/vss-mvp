// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String           @id @default(cuid())
  username        String           @unique
  passwordHash    String
  fullName        String
  email           String?
  role            Role             @default(MEMBER)
  isManager       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  assessments     Assessment[]
  actionResponses ActionResponse[]

  // Finance Dashboard Relations
  assignedTasks   FinanceTask[]    @relation("AssignedTasks")
  createdTasks    FinanceTask[]    @relation("CreatedTasks")
  completedTasks  FinanceTask[]    @relation("CompletedTasks")
  financeComments FinanceComment[] @relation("FinanceComments")
  monthEndSummaries MonthEndSummary[] @relation("PreparedSummaries")

  // HR Review Relations
  feedbackSurvey  HRFeedbackSurvey? @relation("FeedbackSurveys")
  goalSetting     HRGoalSetting?    @relation("GoalSettings")
  interviewNotes  HRInterviewNote[] @relation("InterviewNotes")

  // HR Action Items Relations
  employeeActions HRActionItem[]    @relation("EmployeeActions")
  assignedActions HRActionItem[]    @relation("AssignedActions")
  createdActions  HRActionItem[]    @relation("CreatedActions")

  // Manager Relations
  managedEmployees UserManager[]    @relation("ManagerRelation")
  managers         UserManager[]    @relation("EmployeeRelation")

  // Tender Review Relations
  tenderReviewComments TenderReviewComment[] @relation("TenderReviewer")
}

enum Role {
  ADMIN
  MEMBER
}

model Assessment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  responses   Json
  completed   Boolean   @default(false)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// VSM Action Tracking Models
model ActionItem {
  id            String    @id @default(cuid())
  actionNumber  Int       @unique // 1-7
  actionSlug    String    @unique // e.g., "products-services"
  title         String // Display title
  description   String? // Optional description
  priority      String // "IMMEDIATE" or "SHORT-TERM"
  owner         String // Team member(s) responsible
  status        String    @default("not-started") // not-started, in-progress, completed
  dueDate       DateTime?
  completedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  responses ActionResponse[]
  consensus ActionConsensus?
}

model ActionResponse {
  id           String     @id @default(cuid())
  actionItemId String
  actionItem   ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  // JSON structure to hold all question responses (flexible per action)
  responses Json

  completed   Boolean   @default(false)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([actionItemId, userId]) // One response per user per action
}

model ActionConsensus {
  id           String     @id @default(cuid())
  actionItemId String     @unique
  actionItem   ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)

  // JSON structure for consensus data (varies by action)
  consensusData Json

  notes      String? // Discussion notes
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String? // User ID who marked as resolved

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Data Extraction Review System (Juan-specific)
model DataExtractionProcess {
  id           String   @id @default(cuid())
  version      Int      @default(1)
  processSteps Json // Array of process steps with flowchart data
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  feedbacks DataExtractionFeedback[]
  questions DataExtractionQuestion[]
}

model DataExtractionFeedback {
  id        String                @id @default(cuid())
  processId String
  process   DataExtractionProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  userId    String // Should be Juan's user ID
  stepId    String // Which step this feedback is for

  // Feedback content
  isCorrect       Boolean? // Does this sound correct?
  questionAnswers Json? // Answers to quick questions for this step
  comments        String? // Juan's comments (400 words) - only shown if isCorrect is false or null
  language        String   @default("en") // "en" or "es"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([processId, userId, stepId]) // One feedback per user per step
}

model DataExtractionQuestion {
  id        String                @id @default(cuid())
  processId String
  process   DataExtractionProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  userId    String // Should be Juan's user ID

  // Question response data
  responses   Json // Flexible structure for all question responses
  completed   Boolean   @default(false)
  submittedAt DateTime?
  language    String    @default("en") // "en" or "es"

  // Workspace links and references
  workspaceLinks Json? // Array of Google Workspace/Workbench links

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([processId, userId]) // One set of responses per user per process
}

model DataExtractionResearch {
  id        String   @id @default(cuid())
  processId String // Process ID for the research (e.g., "data-extraction-2025")
  userId    String // User who provided the answers

  // AI Implementation Questions
  answers  Json // Flexible structure for research questions (q1, q2, q3, q4)
  language String   @default("en") // "en" or "es"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, processId]) // One set of research answers per user per process
}

// Finance Dashboard Models
model FinanceTask {
  id              String         @id @default(cuid())
  title           String         // "Run payroll"
  description     String?        // Full instructions
  category        TaskCategory   // CRITICAL, DAILY, WEEKLY, MONTH_END
  priority        TaskPriority   // HIGH, MEDIUM, LOW
  dueDate         DateTime       // Specific date or relative (Day 3)
  recurringRule   String?        // "MONTHLY_DAY_3", "WEEKLY_FRIDAY"
  status          TaskStatus     @default(PENDING)
  assignedToId    String?
  assignedTo      User?          @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User           @relation("CreatedTasks", fields: [createdById], references: [id])
  completedAt     DateTime?
  completedById   String?
  completedBy     User?          @relation("CompletedTasks", fields: [completedById], references: [id])
  comments        FinanceComment[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum TaskCategory {
  CRITICAL        // Payroll, month-end deadlines
  DAILY           // Dext checks
  WEEKLY          // Bill payments
  MONTH_END       // Final reconciliation
  CUSTOM          // User-added tasks
}

enum TaskPriority {
  HIGH            // Must complete today
  MEDIUM          // Complete this week
  LOW             // Complete this month
}

enum TaskStatus {
  PENDING         // Not started
  IN_PROGRESS     // Currently working on
  COMPLETED       // Done
  SNOOZED         // Postponed
  OVERDUE         // Missed deadline
}

model FinanceComment {
  id              String        @id @default(cuid())
  content         String
  taskId          String
  task            FinanceTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation("FinanceComments", fields: [authorId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model FinanceMetric {
  id                    String    @id @default(cuid())
  date                  DateTime  @default(now())
  month                 DateTime  // First day of the month for grouping
  dextPublished         Int       // Number of items published
  dextTotal             Int       // Total items in Dext
  unreconciledLines     Int       // Bank lines not reconciled
  unreconciledOld       Int       // Lines >5 days old
  billsPaid             Int
  billsDueThisWeek      Int
  payrollCompleted      Boolean

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([month])
}

model MonthEndSummary {
  id                  String    @id @default(cuid())
  month               DateTime  // First day of the month
  totalSpend          Decimal
  spendByCategory     Json      // { payroll: 50000, software: 5000, ... }
  variances           Json      // { category: variance, ... }
  cashBalance         Decimal
  upcomingExpenses    Json      // [{ expense, amount, dueDate }, ...]
  issues              String?   // Freeform text
  preparedById        String
  preparedBy          User      @relation("PreparedSummaries", fields: [preparedById], references: [id])

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([month])
}

// HR Review System Models
// Stores employee feedback survey responses (from Employee_Feedback_Survey_2025.csv)
model HRFeedbackSurvey {
  id              String   @id @default(cuid())
  userId          String   // Link to User model
  user            User     @relation("FeedbackSurveys", fields: [userId], references: [id])
  timestamp       DateTime // Original survey submission timestamp

  // Work Engagement Questions
  enjoyedPart         String?  @db.Text // What's one part of your workweek you always enjoy?
  lessOfPart          String?  @db.Text // What's one part you could happily do less of?
  autonomyRating      Int?              // How much autonomy do you feel in your work? (1-10)
  motivationRating    Int?              // How motivated do you feel starting the average workweek? (1-10)
  teamConnection      Int?              // How connected do you feel to your team? (1-10)
  wideLithodatConnection Int?           // How connected do you feel to the wider Lithodat Team? (1-10)
  supportRating       Int?              // How supported do you feel in your day-to-day work? (1-10)

  // Achievement & Recognition
  proudAchievement    String?  @db.Text // What's something you've achieved this year that you're proud of?
  wishRecognised      String?  @db.Text // What's one thing you wish more people recognised about your work?

  // Tools & Collaboration
  toolsEffectiveness  Int?              // How effective do you feel the technological tools you use daily are? (1-10)
  collaborationEase   Int?              // How easy is it to collaborate across Lithodat's teams or functions? (1-10)
  toolsUsed           String?  @db.Text // What tools or platforms do you use regularly?
  aiUsageWorkflow     String?  @db.Text // How do you use AI assistants? Have you developed any workflows?
  aiToolsToExplore    String?  @db.Text // Are there AI tools, workflows or software you'd like to explore?

  // Process Improvement
  inefficiencies      String?  @db.Text // Is there anything in the way we work that feels inefficient?
  toolsCreated        String?  @db.Text // Have you developed any tools, scripts, or processes?
  externalLearnings   String?  @db.Text // Is there something you've learned or experienced outside of Lithodat?

  // Career Development
  careerPathClarity   Int?              // How clear are you on your potential career path within the company? (1-10)
  skillDevelopmentSupport Int?          // How supported do you feel in learning or developing new skills? (1-10)
  skillToGrow         String?  @db.Text // What's a skill you'd like to grow or deepen this year?
  rolesInterested     String?  @db.Text // Are there any roles, positions, or areas you're curious about?
  growthSupport       String?  @db.Text // What would help you feel more encouraged or supported in your growth?

  // Vision & Goals
  greatYearVision     String?  @db.Text // In a sentence or two: What would a great year ahead look like for you?
  excitedProjects     String?  @db.Text // Are there specific types of projects you'd be excited to tackle?
  smallGoals          String?  @db.Text // What's one or two small goals or directions you'd love to explore?
  additionalSharing   String?  @db.Text // Is there anything else you'd like to share?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId]) // One survey response per user
  @@index([userId])
}

// Stores employee goal setting responses (from Annual Goal Setting form)
model HRGoalSetting {
  id                  String   @id @default(cuid())
  userId              String   // Link to User model
  user                User     @relation("GoalSettings", fields: [userId], references: [id])
  timestamp           DateTime // Original form submission timestamp

  // Professional Goals (3 max)
  professionalGoal1Title       String?  @db.Text
  professionalGoal1Description String?  @db.Text
  professionalGoal2Title       String?  @db.Text
  professionalGoal2Description String?  @db.Text
  professionalGoal3Title       String?  @db.Text
  professionalGoal3Description String?  @db.Text

  // Personal Goal (Non-Work Related)
  personalGoalTitle       String?  @db.Text
  personalGoalDescription String?  @db.Text

  // Check-in Preferences (multi-select)
  checkInPreferences  Json?    // Array of strings: ["Mention in 1-on-1 meetings", "Quarterly check-in via email", etc.]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId]) // One goal setting response per user
  @@index([userId])
}

// Stores employee interview notes (from Interview/ markdown files)
model HRInterviewNote {
  id              String   @id @default(cuid())
  userId          String   // Link to User model
  user            User     @relation("InterviewNotes", fields: [userId], references: [id])
  interviewDate   DateTime // Date of the interview

  // Interview Content
  notes           String   @db.Text // Full markdown content of the interview notes
  keyThemes       Json?            // Array of key themes extracted from the interview
  actionItems     Json?            // Array of follow-up action items from the interview (legacy - use HRActionItem table)

  // Metadata
  interviewer     String?          // Who conducted the interview
  interviewType   String?          // "Annual Review", "Performance Review", "Check-in", etc.

  // Relations
  hrActionItems   HRActionItem[]   @relation("InterviewActionItems")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([interviewDate])
}

// HR Action Items - Follow-up actions from interviews or performance reviews
model HRActionItem {
  id                String           @id @default(cuid())
  description       String           @db.Text // What needs to be done

  // Employee this action is for
  employeeId        String
  employee          User             @relation("EmployeeActions", fields: [employeeId], references: [id], onDelete: Cascade)

  // Manager responsible for this action
  assignedToId      String?
  assignedTo        User?            @relation("AssignedActions", fields: [assignedToId], references: [id])

  // Optional link to interview note where this action originated
  interviewNoteId   String?
  interviewNote     HRInterviewNote? @relation("InterviewActionItems", fields: [interviewNoteId], references: [id], onDelete: SetNull)

  // Action details
  dueDate           DateTime?
  status            HRActionStatus   @default(PENDING)
  priority          HRActionPriority @default(MEDIUM)
  notes             String?          @db.Text // Additional context or updates

  // Who created this action item
  createdById       String
  createdBy         User             @relation("CreatedActions", fields: [createdById], references: [id])

  // Completion tracking
  completedAt       DateTime?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([employeeId])
  @@index([assignedToId])
  @@index([interviewNoteId])
  @@index([dueDate])
  @@index([status])
}

enum HRActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HRActionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Manager-Employee relationships (many-to-many since some employees have multiple managers)
model UserManager {
  id         String   @id @default(cuid())
  employeeId String
  employee   User     @relation("EmployeeRelation", fields: [employeeId], references: [id], onDelete: Cascade)
  managerId  String
  manager    User     @relation("ManagerRelation", fields: [managerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([employeeId, managerId])
  @@index([employeeId])
  @@index([managerId])
}

// GDAC-SA Tender Tracker - Saudi Geological Survey RFQ Application (FORM-002)
// Verified against actual RFQ #251140007625 requirements
// All step fields use status: "not_started" | "in_progress" | "blocked" | "complete"
model GdacTenderTracker {
  id                    String   @id @default(cuid())

  // 1. Eligibility & Registration (5 steps)
  step_app_structure    String?  // Solo bid or Consortium decision
  step_misa_register    String?  // Register with Ministry of Investment
  step_etimad_register  String?  // Register on Etimad Platform
  step_etimad_verify    String?  // Verify Etimad Account
  step_locate_rfq       String?  // Locate RFQ on Etimad

  // 2. Required Certificates - Pass/Fail (7 steps)
  step_commercial_reg   String?  // Commercial Registration Certificate
  step_zakat_cert       String?  // Zakat and Income Certificate
  step_vat_cert         String?  // VAT Certificate (if applicable)
  step_gosi_cert        String?  // Social Insurance Certificate (GOSI)
  step_chamber_cert     String?  // Chamber of Commerce Certificate
  step_investment_license String? // Investment License (foreign bidders)
  step_saudization_cert String?  // Saudization Certificate (Taqat)

  // 3. Quality & HSE Certificates - 20% of Technical (2 steps)
  step_quality_cert     String?  // Quality Policy/Certificate
  step_hse_cert         String?  // HSE Policy/Certificate

  // 4. Financial Documents - 40% of Total (4 steps)
  step_fin_year0        String?  // Audited Financial Statements - Current Year
  step_fin_year1        String?  // Audited Financial Statements - Year -1
  step_fin_year2        String?  // Audited Financial Statements - Year -2
  step_extract_data     String?  // Extract Financial Data for Ratios

  // 5. Consortium Documents (2 steps - if applicable)
  step_alliance_agreement String? // Alliance Agreement
  step_partner_docs     String?  // Partner Certificates

  // 6. Application Forms (8 steps)
  step_form_applicant   String?  // Form: Applicant Information
  step_form_tech_admin  String?  // Form: Technical & Administrative Capabilities
  step_form_admin_staff String?  // Form: Administrative Staff Experience (10)
  step_form_prof_staff  String?  // Form: Professional Staff Experience (20)
  step_form_project1    String?  // Form: Similar Project #1
  step_form_project2    String?  // Form: Similar Project #2
  step_form_project3    String?  // Form: Similar Project #3
  step_form_financial   String?  // Form: Financial Capacity Criteria

  // 7. Quality Assurance Checks (7 steps)
  step_qa_seals         String?  // All Documents Stamped with Company Seal
  step_qa_expiry        String?  // All Certificates Valid (Not Expired)
  step_qa_searchable    String?  // All Documents in Searchable PDF Format
  step_qa_electronic    String?  // All Forms Filled Electronically
  step_qa_complete      String?  // All Required Fields Completed
  step_qa_consistent    String?  // Information Consistent Across Forms
  step_qa_concise       String?  // Only Requested Information Included

  // 8. Submission via Etimad (6 steps)
  step_compile_package  String?  // Compile All Documents
  step_final_review     String?  // Final Review
  step_test_upload      String?  // Test Upload Capability
  step_submit           String?  // Upload Application Package
  step_verify_submit    String?  // Verify Successful Submission
  step_save_receipt     String?  // Save Confirmation/Receipt

  // 9. Post-Submission (2 steps)
  step_monitor_queries  String?  // Monitor Etimad for Queries
  step_await_results    String?  // Await Qualification Results

  // Contacts & Notes
  sgsContactNotes       String?  @db.Text
  etimadContactNotes    String?  @db.Text
  internalNotes         String?  @db.Text
  lessonsLearned        String?  @db.Text

  // Metadata
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lastUpdatedById       String?
}

// GDAC Tender Review Comments - Reviewer feedback on tender response sections
model TenderReviewComment {
  id              String   @id @default(cuid())
  formId          String   // e.g., "FORM-9.1", "FORM-9.2", etc.
  sectionId       String   // Section within the form (e.g., "section-a", "section-b-1")
  comment         String   @db.Text
  status          TenderCommentStatus @default(PENDING)

  // Reviewer info
  reviewerId      String
  reviewer        User     @relation("TenderReviewer", fields: [reviewerId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([formId])
  @@index([reviewerId])
  @@unique([formId, sectionId, reviewerId]) // One comment per section per reviewer
}

enum TenderCommentStatus {
  PENDING      // Comment submitted, awaiting response
  ADDRESSED    // Issue has been addressed
  RESOLVED     // Reviewer confirmed resolution
  WONT_FIX     // Intentionally not addressing
}

// Product Tier Configuration - Editable tier data for LithoSurfer and LithoData
model ProductTierConfig {
  id          String   @id @default(cuid())
  productType String   // "lithosurfer" or "lithodata"
  tierName    String   // "free", "pro", "enterprise" for LithoSurfer; "free", "premium", "marketplace" for LithoData

  // Tier details
  price           String?  // e.g., "$0", "$2,500 - $5,000/year", "30% Commission"
  priceNote       String?  // e.g., "Pricing under debate"
  target          String?  // Target customer description
  source          String?  // For LithoData: data source description

  // Features (stored as JSON arrays)
  featuresIn      Json     // Array of { category: string, feature: string, note?: string }
  featuresOut     Json     // Array of { category: string, feature: string, upgradePath?: string }

  // Additional notes
  restrictions    String?  @db.Text  // Restriction notes
  keyDifferentiator String? @db.Text // Key selling point

  // Metadata
  lastEditedBy    String?  // User ID who last edited
  lastEditedAt    DateTime @default(now())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productType, tierName])
  @@index([productType])
}
